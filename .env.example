# Copy to .env (git-ignored) and fill in. Never commit .env.
# Used only by the AI track (src/ai/llm.py). Every prompt passes the NDA gate (src/ai/guard.py) first,
# whichever provider is used.

# Claude API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model and spending cap for the whole AI track (USD, summed over data/outputs/ai/llm_log.jsonl)
AI_MODEL=claude-opus-5-5
AI_BUDGET_USD=5

# Provider: "ollama" = local model, nothing leaves the machine, no cost (default); "anthropic" = Claude API
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
# qwen3 reasons before answering (slower, usually better proposals); set false for speed
OLLAMA_THINK=true
