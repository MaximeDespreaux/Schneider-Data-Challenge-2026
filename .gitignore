# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environments
.venv/
.env

# Jupyter
.ipynb_checkpoints/

# OS / editors
.DS_Store
.vscode/
.idea/

# Data (not tracked; keep folder)
data/*
!data/.gitkeep

# Confidential data must never be committed, wherever it lands in the repo.
# Notebook *outputs* are stripped at commit time by nbstripout (see .gitattributes).
*.zip
*.xlsx
*.xls
*.xlsm
*.csv
*.parquet
*.pkl
*.pdf

# Notebook exports and generated outputs (figures, tables, reports)
outputs/
figures/
reports/
notebooks/**/*.html
notebooks/**/*.png
notebooks/**/*.svg
